NAVIDROME_URL=http://192.168.1.50:4533
SESSION_SECRET=replace-with-at-least-32-random-characters
NEEDLEDROP_DATA_DIR=/data
COOKIE_SECURE=false
MUSICBRAINZ_USER_AGENT=NeedleDrop/0.7.2 (https://github.com/bclark303/needledrop)
DISCOGS_TOKEN=
LASTFM_API_KEY=
# Optional Lidarr bootstrap values. These can also be saved in Library Manager.
LIDARR_URL=http://192.168.1.50:8686
LIDARR_API_KEY=
# Optional NZB Track Repair bootstrap values. These can also be saved in Library Manager.
# Provider may be: newznab, nzbhydra2, or prowlarr.
NZB_REPAIR_PROVIDER=newznab
NZB_INDEXER_URL=
NZB_INDEXER_API_KEY=
NZB_INDEXER_CATEGORIES=3000,3040
SABNZBD_URL=http://192.168.1.50:8080
SABNZBD_API_KEY=
SABNZBD_REPAIR_CATEGORY=needledrop-repair
NZB_REPAIR_STAGING_PATH=/repair
NZB_REPAIR_IMPORT_PATH=/music-repair
NZB_REPAIR_CLEANUP=true
NZB_REPAIR_PREFER_LOSSLESS=true
# Docker Compose host-side paths for the two narrow repair mounts.
# The staging path should be the completed folder used by the SAB category above.
# The import path must be a dedicated folder inside a music tree scanned by Navidrome.
NZB_REPAIR_STAGING_HOST=./repair-staging
NZB_REPAIR_IMPORT_HOST=./repair-music
# Runtime UID/GID. Unraid commonly uses nobody:users = 99:100.
PUID=1001
PGID=1001
UMASK=002
# Optional comma-separated Navidrome usernames allowed to change system settings.
# Leave blank for a single-user/home install where any authenticated user may manage settings.
NEEDLEDROP_ADMIN_USERS=
